{
  "id": "example-ai-triage",
  "name": "範例：客戶訊息 AI 秒分類,客訴自動走加急通道",
  "status": "official",
  "description": "打一句客戶訊息進來,AI 判斷是客訴/售後/詢價/其他——是客訴就走「加急通道」立刻擬道歉回覆並標記優先處理,其他走標準回覆。這就是流程圖會「分岔」的樣子:同一個入口,不同狀況自動走不同的路。",
  "requiresSecrets": [],
  "triggerParams": [
    {
      "key": "customerMessage",
      "label": "客戶訊息(隨便打一句試試)",
      "type": "text",
      "default": "等了兩週商品還沒到,再不出貨我要退款並向消保官申訴!"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger",
      "label": "開始(填一句訊息)",
      "config": {},
      "position": {
        "x": 0,
        "y": 60
      }
    },
    {
      "id": "classify",
      "type": "llm-decide",
      "label": "AI 判斷這是哪種訊息",
      "config": {
        "prompt": "這是一則客戶來訊:「{{customerMessage}}」。請判斷它屬於哪一類。",
        "outputKey": "分類結果",
        "choices": "客訴,售後維修,購買諮詢,其他"
      },
      "position": {
        "x": 240,
        "y": 60
      }
    },
    {
      "id": "route",
      "type": "switch",
      "label": "客訴走加急、其他走標準",
      "config": {
        "value": "{{分類結果}}",
        "cases": "客訴"
      },
      "position": {
        "x": 480,
        "y": 60
      }
    },
    {
      "id": "urgent",
      "type": "template-text",
      "label": "擬加急道歉回覆",
      "config": {
        "template": "🚨【加急】客訴案件,建議 1 小時內回覆:\n\n「親愛的顧客您好,非常抱歉讓您久等了。我們已將您的案件列為最優先處理,將於今日內回覆出貨進度與補償方案。」\n\n(原訊息:{{customerMessage}})",
        "outputKey": "回覆草稿"
      },
      "position": {
        "x": 720,
        "y": 0
      }
    },
    {
      "id": "normal",
      "type": "template-text",
      "label": "擬標準回覆",
      "config": {
        "template": "已分類為【{{分類結果}}】,回覆草稿:\n\n「您好,感謝您的來訊!我們已收到您的需求,客服人員將於一個工作天內回覆您。」\n\n(原訊息:{{customerMessage}})",
        "outputKey": "回覆草稿"
      },
      "position": {
        "x": 720,
        "y": 130
      }
    },
    {
      "id": "notify",
      "type": "desktop-notify",
      "label": "跳通知看回覆草稿",
      "config": {
        "title": "AI 分類:{{分類結果}}",
        "message": "{{回覆草稿}}"
      },
      "position": {
        "x": 960,
        "y": 60
      }
    }
  ],
  "edges": [
    {
      "from": "trigger",
      "to": "classify"
    },
    {
      "from": "classify",
      "to": "route"
    },
    {
      "from": "route",
      "to": "urgent",
      "fromPort": "客訴"
    },
    {
      "from": "route",
      "to": "normal",
      "fromPort": "其他"
    },
    {
      "from": "urgent",
      "to": "notify"
    },
    {
      "from": "normal",
      "to": "notify"
    }
  ]
}